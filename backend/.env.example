# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development

# Supabase -> Project Settings -> Database -> Connection string (Session pooler, port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>
# Only for projects still on the legacy HS256 JWT secret. Leave empty for asymmetric (JWKS) signing keys.
SUPABASE_JWT_SECRET=

# Exact origin of the deployed frontend (no trailing slash). Locally: the static server's origin.
FRONTEND_ORIGIN=http://localhost:5500

# AWS (IAM user scoped to the bucket, Bedrock InvokeModel, and SES SendRawEmail)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
BEDROCK_REGION=ap-south-1
# Check what your region offers:  aws bedrock list-inference-profiles --region ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
LLM_ENABLED=true

# Email via SES (verify the sender first; sandbox accounts can only send to verified addresses)
EMAIL_ENABLED=false
SES_FROM_EMAIL=
SES_CONFIGURATION_SET=

EMBEDDINGS_PROVIDER=fastembed
EMBEDDING_CACHE_DIR=./.models
